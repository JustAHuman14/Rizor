<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>com.JustAHuman.Rizor</ApplicationId>
    <ApplicationTitle>Rizor</ApplicationTitle>
    <ApplicationVersion>3</ApplicationVersion>
    <ApplicationDisplayVersion>1.2.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <PublishTrimmed>true</PublishTrimmed>
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>Rizor.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>Rizor</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(ANDROID_SIGNING_PASSWORD)</AndroidSigningKeyPass>
    <AndroidSigningStorePass>$(ANDROID_SIGNING_PASSWORD)</AndroidSigningStorePass>
    <AndroidSdkDirectory>$(ANDROID_SDK_DIRECTORY)</AndroidSdkDirectory>
    <JavaSdkDirectory>$(JAVA_SDK_DIRECTORY)</JavaSdkDirectory>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rizor.Core\Rizor.Core.csproj" />
  </ItemGroup>
</Project>
